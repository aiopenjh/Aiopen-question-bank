{
  "expo": {
    "name": "Celueste",
    "slug": "celueste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./MAIN.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.celueste.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./MAIN.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./MAIN.png"
    },
    "experiments": {
      "baseUrl": "/Aiopen-question-bank"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./MAIN.png",
          "color": "#6366F1"
        }
      ]
    ]
  }
}
