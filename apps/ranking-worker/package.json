{
  "name": "celueste-ranking-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Celueste 선택형 공동 랭킹 API (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply celueste-ranking --local",
    "db:migrate:remote": "wrangler d1 migrations apply celueste-ranking --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.136.3"
  }
}
